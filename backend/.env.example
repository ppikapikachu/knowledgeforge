# Application
APP_NAME=interview_agent
APP_ENV=development
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=interview_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM Configuration (for KnowledgeExtractAgent)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Chunker Configuration
CHUNK_SIZE=6000
CHUNK_OVERLAP=500

# Agent Configuration
AGENT_MAX_RETRIES=2
