# Application
APP_NAME=interview_agent
APP_ENV=development
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=interview_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM Configuration (for KnowledgeExtractAgent)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Chunker Configuration
CHUNK_SIZE=6000
CHUNK_OVERLAP=500

# Agent Configuration
AGENT_MAX_RETRIES=2

# Embedding Configuration (本地 FlagModel)
EMBEDDING_MODEL=D:/python/ai_model/models--BAAI--bge-small-zh-v1.5/snapshots/7999e1d3359715c523056ef9478215996d62a620
EMBEDDING_USE_FP16=true

# Deduplication Configuration
DEDUP_LOW_THRESHOLD=0.60
DEDUP_HIGH_THRESHOLD=0.88
DEDUP_TOP_K=3

# Question Deduplication (多层去重)
QUESTION_DEDUP_ENABLED=true
QUESTION_DEDUP_SAME_SCOPE_CANDIDATE_THRESHOLD=0.65
QUESTION_DEDUP_CROSS_SCOPE_HIGH_THRESHOLD=0.75
QUESTION_DEDUP_FINAL_BLOCK_THRESHOLD=0.85
QUESTION_DEDUP_VECTOR_TOP_K=15
QUESTION_DEDUP_KEYWORD_TOP_K=15
QUESTION_DEDUP_LLM_MAX_CANDIDATES=5
QUESTION_DEDUP_LLM_BATCH_SIZE=5
QUESTION_DEDUP_MAX_REGENERATION_ATTEMPTS=2
QUESTION_DEDUP_MAX_GENERATION_MULTIPLIER=1.5
QUESTION_DEDUP_LLM_TIMEOUT_SECONDS=60
EMBEDDING_VERSION=bge-small-zh-v1.5

# AI Quality Review (QuestionReviewAgent)
# 后端功能总开关（默认关闭）。部署启用前必须显式配置为 true
QUESTION_AI_REVIEW_ENABLED=false
# 独立审核模型（可选）；为空时复用 LLM_MODEL
QUESTION_AI_REVIEW_MODEL=
# 单题审核单次模型调用超时（秒），超时 fail-safe 转人工
QUESTION_AI_REVIEW_TIMEOUT_SECONDS=60
# 单题审核模型调用重试上限
QUESTION_AI_REVIEW_MAX_RETRIES=1
# 每任务最大审核题目数（成本保护）
QUESTION_AI_REVIEW_MAX_PER_TASK=200
# 每任务审核并发上限（第一版串行）
QUESTION_AI_REVIEW_MAX_CONCURRENCY=1
